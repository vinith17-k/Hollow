{
  "version": 2,
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/device",
      "destination": "/device.html"
    },
    {
      "source": "/device.html",
      "destination": "/device.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
