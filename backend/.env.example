# Environment configuration
# Copy this to .env and fill in your values

PORT=4000

# ── Local SQLite (default — no cloud needed) ────────────────────────────────
# Nothing extra needed. The DB file is created automatically at backend/data.db

# ── Supabase (swap in when ready) ───────────────────────────────────────────
# Uncomment and fill these to point the backend at a real Supabase project.
# The route shape is identical — nothing else changes.
#
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# In server.js, set USE_SUPABASE=true and the routes will proxy to Supabase
# instead of SQLite.
